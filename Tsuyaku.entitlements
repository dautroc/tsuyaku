<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No App Sandbox: sandboxing without a provisioning profile fights the
         Core Audio tap + aggregate device path for no benefit in a local build. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
